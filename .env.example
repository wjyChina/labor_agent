# Copy to .env. Never commit your API key.
LABOR_API_KEY=
LABOR_BASE_URL=https://api.deepseek.com
LABOR_MODEL=deepseek-flash

# Responses API: local history is required by DeepSeek's stateless endpoint.
# Use previous_response_id only with gateways that actually support it.
LABOR_CACHE_MODE=local
LABOR_REASONING_EFFORT=high
LABOR_MAX_OUTPUT_TOKENS=32768
# Context budget used for preflight warnings. Override for another model or gateway.
LABOR_CONTEXT_LIMIT_TOKENS=1048576
LABOR_CONTEXT_WARN_RATIO=0.9
LABOR_REQUEST_TIMEOUT_MS=180000

# Relative paths resolve against this project, not the MCP client's cwd.
LABOR_WORKSPACE=.
LABOR_DATA_DIR=.labor-agent
LABOR_PORT=3210

# Optional. Windows auto-detects Git Bash; other systems use /bin/bash.
# LABOR_BASH_PATH=C:/Program Files/Git/bin/bash.exe
